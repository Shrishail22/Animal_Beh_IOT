# ==========================================
# Animal Behavior Monitoring - Backend Config
# ==========================================

# Database Selection:
# --------------------
# 1. SQLite (Default / Zero-Config):
#    Leave DB_USER and DB_PASSWORD empty.
#    The system will automatically use backend/animaldb.sqlite with auto-seeding.
#
# 2. MySQL (Full Enterprise / Production):
#    Set your MySQL connection credentials below and ensure MySQL is running.
#    The backend will automatically create tables and connect to MySQL.
#    You can also import Dump20261008.sql directly into your MySQL server.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=animaldb
DB_USER=
DB_PASSWORD=

# Server Settings
PORT=8000
HOST=0.0.0.0
DEBUG=True
